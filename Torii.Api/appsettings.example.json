{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ToriiDb": "Host=localhost;Port=5432;Database=torii;Username=...;Password=..."
  },
  "Jwt": {
    "Issuer": "Torii",
    "Audience": "ToriiClient",
    "Key": "FILL-IN-with-a-secret-key-of-at-least-32-characters",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Seed": {
    "Admin": {
      "Email": "admin@torii.dev",
      "Password": "FILL-IN-8-characters-minimum (or user-secrets / Seed__Admin__Password)",
      "DisplayName": "Administrator"
    }
  }
}
